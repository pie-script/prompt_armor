# =============================================================================
# PromptArmor: Enterprise LLM Security Gateway Environment Configuration
# Copy this file to .env and populate your active operational keys.
# =============================================================================

# --- Core Gateway Configuration ---
APP_NAME="PromptArmor Gateway"
DEBUG=True
HOST=127.0.0.1
PORT=8000
MAX_PROMPT_LENGTH=4000

# --- LLM Security Providers ---
# Groq API Key (Required for Layer 3 Semantic Safeguard & Downstream Proxy)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (Optional alternate guard provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Guard Model Classifier Identifier
LLM_GUARD_MODEL=openai/gpt-oss-safeguard-20b

# Downstream Target Model Identifier
DOWNSTREAM_LLM_MODEL=openai/gpt-oss-120b

# --- Telemetry & Relational Database ---
DATABASE_URL=sqlite:///./data/security_logs.db